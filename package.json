{
    "name": "jp-local-gov",
    "version": "2.2.1",
    "description": "Data and utilities for Japanese prefectures, electoral districts, municipality codes, and mesh codes.",
    "homepage": "https://github.com/hideo54/jp-local-gov#readme",
    "bugs": {
        "url": "https://github.com/hideo54/jp-local-gov/issues"
    },
    "license": "MIT",
    "author": "Hideo Yasumoto",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hideo54/jp-local-gov.git"
    },
    "files": [
        "dist",
        "src"
    ],
    "engines": {
        "node": ">=22.12"
    },
    "type": "module",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "default": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "scripts": {
        "build": "tsc",
        "test": "vitest"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.9",
        "@typescript/native-preview": "7.0.0-dev.20260707.2",
        "@vitest/coverage-v8": "4.1.11",
        "lint-staged": "^17.3.0",
        "typescript": "^7.0.2",
        "vitest": "^4.1.11"
    },
    "lint-staged": {
        "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
            "biome check --write --unsafe --no-errors-on-unmatched"
        ]
    },
    "packageManager": "pnpm@10.33.2"
}
